# ==================== 必填 ====================

# 管理面板和管理接口的认证密钥（必须修改！）
ADMIN_KEY=changeme

# ==================== 可选 ====================

# 服务端口
PORT=38412

# 数据目录（Docker 环境默认 /app/data）
DATA_DIR=/app/data

# 签名密钥（用于智谱 API 请求签名，一般不需要改）
# SIGN_SECRET=8a1317a7468aa3ad86e997d08f3f31cb

# 自动删除会话（true=开启，false=关闭）防止多用户串台
AUTO_DELETE=true

# ==================== Token 轮询调优 ====================

# 同一 token 最小使用间隔（毫秒）
TOKEN_MIN_INTERVAL=3000

# 每个 token 每分钟最大请求数
TOKEN_RATE_LIMIT=20

# 全局每秒最大并发请求数
GLOBAL_QPS=10
